PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas or Local MongoDB Connection
# Replace with your real Atlas URI or local connection string
MONGODB_URI=mongodb://127.0.0.1:27017/zed_tutor

# JWT Secret — CHANGE THIS to a long random string before deploying
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING

# Admin Credentials — CHANGE BOTH before deploying
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM NOTIFICATION (Optional — for tutoring inquiry alerts)
# ──────────────────────────────────────────────────────────────────────────────
# SECURITY WARNING:
#   - TELEGRAM_BOT_TOKEN is a SECRET credential issued by BotFather.
#   - NEVER commit it to Git, GitHub, or any version control system.
#   - NEVER paste it into source code, frontend files, or documentation.
#   - If accidentally exposed: revoke immediately at t.me/BotFather (/revoke)
#     then generate a new token and place ONLY in your real .env file.
#   - This .env.example is safe to commit — it contains NO real values.
# ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudinary Storage for Certificate Uploads (Optional — configure when deploying)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
